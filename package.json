{
  "name": "rovai-ai",
  "productName": "Rovai-ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A local-first workspace for durable agent teams.",
  "author": "murray17",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:check:version": "node scripts/check-doc-version.mjs",
    "docs:check:adr": "node scripts/check-doc-adr.mjs",
    "docs:check:ci": "node scripts/check-doc-version.mjs && node scripts/check-doc-adr.mjs --require-base",
    "docs:test": "node --test scripts/lib/doc-adr.test.mjs",
    "docs:adr:generate": "node scripts/generate-doc-adr.mjs",
    "docs:check": "pnpm docs:check:version && pnpm docs:check:adr",
    "core:build": "node scripts/build-core.mjs --release",
    "core:build:debug": "node scripts/build-core.mjs",
    "native:build:macos": "node scripts/build-open-panel-prewarm.mjs",
    "dev": "pnpm core:build:debug && pnpm native:build:macos && electron-vite dev",
    "build:desktop": "pnpm native:build:macos && electron-vite build",
    "build": "pnpm core:build && pnpm build:desktop",
    "typecheck": "tsc --noEmit",
    "test": "pnpm docs:test && pnpm docs:check && vitest run && node --test scripts/lib/qualification-acceptance-v034.test.mjs scripts/lib/qualification-acceptance-v036.test.mjs scripts/lib/qualification-artifacts.test.mjs scripts/lib/qualification-bundle.test.mjs scripts/lib/qualification-case-v3.test.mjs scripts/lib/qualification-collaboration.test.mjs scripts/lib/qualification-collaboration-ledger.test.mjs scripts/lib/qualification-diagnostic-portfolio.test.mjs scripts/lib/qualification-evaluation.test.mjs scripts/lib/qualification-evidence-index.test.mjs scripts/lib/qualification-isolation.test.mjs scripts/lib/qualification-public-report.test.mjs scripts/lib/qualification-recovery.test.mjs scripts/lib/qualification-schema-validation.test.mjs scripts/lib/qualification-semantic-judge.test.mjs scripts/lib/qualification-tool-evidence.test.mjs scripts/lib/qualification-tool-ledger.test.mjs scripts/lib/qualification-workspace-mutation-ledger.test.mjs",
    "smoke:core": "pnpm core:build:debug && node scripts/smoke-core.mjs",
    "smoke:member-config": "pnpm core:build:debug && node scripts/smoke-member-config.mjs",
    "smoke:intake": "pnpm core:build:debug && node scripts/smoke-intake.mjs",
    "smoke:acp-runtime": "pnpm core:build:debug && node scripts/smoke-acp-runtime.mjs",
    "smoke:claude-runtime": "pnpm core:build:debug && node scripts/smoke-claude-runtime.mjs",
    "smoke:antigravity-runtime": "pnpm core:build:debug && node scripts/smoke-antigravity-runtime.mjs",
    "smoke:builtin-cli": "pnpm core:build:debug && node scripts/smoke-builtin-cli.mjs",
    "qualification:demo:check": "node scripts/qualification-case.mjs check --case qualification/demo/DEMO-001",
    "qualification:case": "node scripts/qualification-case.mjs",
    "qualification:run": "node scripts/qualification-runner.mjs",
    "qualification:evaluate": "node scripts/qualification-evaluate.mjs",
    "qualification:judge": "node scripts/qualification-semantic-review.mjs",
    "qualification:bundle:verify": "node scripts/qualification-verify-bundle.mjs",
    "qualification:portfolio": "node scripts/qualification-diagnostic-portfolio.mjs",
    "qualification:acceptance:v0.34": "node scripts/qualification-acceptance-v034.mjs",
    "qualification:acceptance:v0.36": "node scripts/qualification-acceptance-v036.mjs",
    "qualification:suite": "node scripts/qualification-suite.mjs",
    "qualification:project": "node scripts/project-qualification-benchmark.mjs",
    "smoke:action-approval": "pnpm core:build:debug && node scripts/smoke-action-approval.mjs",
    "smoke:runtime-permissions": "pnpm smoke:action-approval && pnpm smoke:multi-agent",
    "accept:v0.16": "cargo test -p rovai-core db::tests::v27_freezes_active_runs_on_legacy_semantics_and_keeps_terminal_history && cargo test -p rovai-core team_tool::tests::call_member_persists_one_input_before_materializing_one_run && cargo test -p rovai-core action::tests::restart_fails_closed_intercepted_approvals_and_authorization_deliveries && pnpm test && pnpm smoke:runtime-permissions && pnpm smoke:acp-runtime",
    "accept:v0.17": "cargo test -p rovai-core db::tests::v28_adds_execution_evidence_and_structured_camp_presentations && cargo test -p rovai-core execution_evidence::tests::provider_packets_are_reduced_to_public_evidence_fields && cargo test -p rovai-core execution_evidence::tests::evidence_is_durable_blob_backed_agent_inaccessible_and_cancel_fenced && cargo test -p rovai-core runtime::tests::camp_turn_cancellation_is_persisted_and_finalized_from_authoritative_state && cargo test -p rovai-core team_tool::tests::recipient_completion_without_another_call_never_contacts_the_source && cargo test -p rovai-core --bin rovai-core tests::acp_tool_events_expose_digests_not_raw_payloads && pnpm typecheck && pnpm test",
    "smoke:multi-agent": "pnpm core:build:debug && node scripts/smoke-multi-agent.mjs",
    "smoke:attachments": "pnpm core:build:debug && node scripts/smoke-camp-attachments.mjs",
    "smoke:skills": "pnpm core:build:debug && node scripts/smoke-skills.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:mcp-projection": "pnpm core:build:debug && node scripts/smoke-mcp-projection.mjs",
    "smoke:mcp-presets": "node scripts/smoke-mcp-presets.mjs",
    "smoke:memory": "pnpm core:build:debug && node scripts/smoke-memory.mjs",
    "smoke:memory-runtime": "pnpm core:build:debug && node scripts/smoke-memory-runtime.mjs",
    "accept:memory-ui": "node scripts/accept-memory-ui.mjs",
    "accept:member-avatar-ui": "node scripts/accept-member-avatar-ui.mjs",
    "accept:member-lifecycle-ui": "node scripts/accept-member-lifecycle-ui.mjs",
    "accept:notification-ui": "node scripts/accept-notification-ui.mjs",
    "accept:sidebar-ui": "node scripts/accept-sidebar-ui.mjs",
    "accept:structured-mentions-ui": "node scripts/accept-structured-mentions-ui.mjs",
    "accept:task-card-ui": "node scripts/accept-task-card-ui.mjs",
    "accept:runtime-activity-ui": "node scripts/accept-runtime-activity-ui.mjs",
    "accept:diagnostics-ui": "node scripts/accept-diagnostics-ui.mjs",
    "smoke:recovery": "pnpm core:build:debug && node scripts/smoke-recovery.mjs",
    "package:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "dist:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-tabs": "1.1.17",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "ai.rovai.desktop",
    "productName": "Rovai-ai",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin/rovai-core",
        "to": "bin/rovai-core"
      },
      {
        "from": "resources/bin/rovai",
        "to": "bin/rovai"
      },
      {
        "from": "resources/native/open-panel-prewarm.node",
        "to": "native/open-panel-prewarm.node"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "target": [
        "dir",
        "dmg"
      ],
      "artifactName": "Rovai-ai-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Rovai-ai ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
