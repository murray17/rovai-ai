{
  "name": "rovai-ai",
  "productName": "Rovai-ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A local-first workspace for durable agent teams.",
  "author": "murray17",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core:build": "node scripts/build-core.mjs --release",
    "core:build:debug": "node scripts/build-core.mjs",
    "dev": "pnpm core:build:debug && electron-vite dev",
    "build:desktop": "electron-vite build",
    "build": "pnpm core:build && pnpm build:desktop",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:core": "pnpm core:build:debug && node scripts/smoke-core.mjs",
    "smoke:member-config": "pnpm core:build:debug && node scripts/smoke-member-config.mjs",
    "smoke:intake": "pnpm core:build:debug && node scripts/smoke-intake.mjs",
    "smoke:acp-runtime": "pnpm core:build:debug && node scripts/smoke-acp-runtime.mjs",
    "smoke:claude-runtime": "pnpm core:build:debug && node scripts/smoke-claude-runtime.mjs",
    "smoke:antigravity-runtime": "pnpm core:build:debug && node scripts/smoke-antigravity-runtime.mjs",
    "smoke:action-approval": "pnpm core:build:debug && node scripts/smoke-action-approval.mjs",
    "smoke:runtime-permissions": "pnpm smoke:action-approval && pnpm smoke:multi-agent",
    "accept:v0.16": "cargo test -p rovai-core db::tests::v27_freezes_active_runs_on_legacy_semantics_and_keeps_terminal_history && cargo test -p rovai-core team_tool::tests::post_message_atomically_delivers_and_queues_one_a2a_run && cargo test -p rovai-core action::tests::restart_fails_closed_intercepted_approvals_and_authorization_deliveries && pnpm test && pnpm smoke:runtime-permissions && pnpm smoke:acp-runtime",
    "accept:v0.17": "cargo test -p rovai-core db::tests::v28_adds_execution_evidence_and_structured_camp_presentations && cargo test -p rovai-core execution_evidence::tests::provider_packets_are_reduced_to_public_evidence_fields && cargo test -p rovai-core execution_evidence::tests::evidence_is_durable_blob_backed_agent_inaccessible_and_cancel_fenced && cargo test -p rovai-core runtime::tests::camp_turn_cancellation_is_persisted_and_finalized_from_authoritative_state && cargo test -p rovai-core team_tool::tests::omitted_reply_id_is_inferred_only_when_returning_to_the_a2a_sender && cargo test -p rovai-core --bin rovai-core tests::acp_tool_events_expose_digests_not_raw_payloads && pnpm typecheck && pnpm test",
    "smoke:multi-agent": "pnpm core:build:debug && node scripts/smoke-multi-agent.mjs",
    "smoke:team-context": "pnpm core:build:debug && node scripts/smoke-team-context.mjs",
    "smoke:team-tasks": "pnpm core:build:debug && node scripts/smoke-team-task-tools.mjs",
    "smoke:skills": "pnpm core:build:debug && node scripts/smoke-skills.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:memory": "pnpm core:build:debug && node scripts/smoke-memory.mjs",
    "smoke:memory-runtime": "pnpm core:build:debug && node scripts/smoke-memory-runtime.mjs",
    "accept:memory-ui": "node scripts/accept-memory-ui.mjs",
    "accept:member-avatar-ui": "node scripts/accept-member-avatar-ui.mjs",
    "accept:member-lifecycle-ui": "node scripts/accept-member-lifecycle-ui.mjs",
    "smoke:recovery": "pnpm core:build:debug && node scripts/smoke-recovery.mjs",
    "package:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "dist:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-tabs": "1.1.17",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ai.rovai.desktop",
    "productName": "Rovai-ai",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin/rovai-core",
        "to": "bin/rovai-core"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "target": [
        "dir",
        "dmg"
      ],
      "artifactName": "Rovai-ai-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Rovai-ai ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
