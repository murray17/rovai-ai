{
  "name": "rovai-ai",
  "productName": "Rovai AI",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "A desktop workspace for long-lived agent teams, shared Camps, visible execution, and collaborative memory.",
  "author": "murray17",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:check:version": "node scripts/check-doc-version.mjs",
    "docs:check:decisions": "node scripts/check-doc-decisions.mjs",
    "docs:check:ci": "node scripts/check-doc-version.mjs && node scripts/check-doc-decisions.mjs --require-base",
    "docs:test": "node --test scripts/lib/doc-decisions.test.mjs",
    "docs:check": "pnpm docs:check:version && pnpm docs:check:decisions",
    "skills:check": "node scripts/check-skills.mjs",
    "skills:test": "node --test scripts/lib/skill-authoring.test.mjs",
    "core:build": "node scripts/build-core.mjs --release",
    "core:build:debug": "node scripts/build-core.mjs",
    "core:build:macos:arm64": "node scripts/build-core.mjs --release --target-key macos-arm64",
    "core:build:macos:x64": "node scripts/build-core.mjs --release --target-key macos-x64",
    "core:build:windows:x64": "node scripts/build-core.mjs --release --target-key windows-x64",
    "check:rust": "cargo check --workspace --all-targets",
    "test:rust:lib": "cargo test -p rovai-core --lib",
    "test:rust:cli": "cargo test -p rovai-core --bin rovai",
    "test:rust:core": "cargo test -p rovai-core --bin rovai-core",
    "test:rust:workspace-default": "cargo test --workspace",
    "test:rust:slow": "cargo test -p rovai-core --features slow-tests --lib slow_tests::",
    "test:rust:pr": "pnpm test:rust:lib && pnpm test:rust:cli && pnpm test:rust:slow",
    "test:rust:full": "pnpm test:rust:workspace-default",
    "test:rust:staged": "node scripts/check-rust-staged.mjs",
    "dev": "pnpm core:build:debug && node scripts/dev-desktop.mjs",
    "build:desktop": "electron-vite build",
    "build": "pnpm core:build && pnpm build:desktop",
    "build:macos:arm64": "pnpm core:build:macos:arm64 && pnpm build:desktop",
    "build:macos:x64": "pnpm core:build:macos:x64 && pnpm build:desktop",
    "build:windows:x64": "pnpm core:build:windows:x64 && pnpm build:desktop",
    "typecheck": "tsc --noEmit",
    "test:electron-sandbox-capability": "node --test scripts/lib/electron-sandbox-capability.test.mjs",
    "test:desktop-bridge": "node --test scripts/lib/rovai-request-context-bridge.test.mjs",
    "test:dingtalk-login": "node --test scripts/lib/dingtalk-login-presentation.test.mjs",
    "test:composer-input": "node --test scripts/lib/structured-mention-composer.test.mjs",
    "test:composer-continuation": "node --test scripts/lib/camp-composer-continuation.test.mjs",
    "test:startup-presentation": "node --test scripts/lib/desktop-startup-presentation.test.mjs",
    "test:camp-fast-layout": "node --test scripts/lib/camp-fast-layout.test.mjs",
    "test:channel-camp-naming": "node --test scripts/lib/channel-camp-naming.test.mjs",
    "test:camp-open-projection": "node --test scripts/lib/camp-open-projection.test.mjs",
    "review:attachments": "node scripts/review-attachment-presentation.mjs",
    "test:execution-avatar-rail": "node --test scripts/lib/execution-avatar-rail.test.mjs",
    "test:approval-dock": "node --test scripts/lib/approval-dock.test.mjs",
    "test:file-preview-layout": "node --test scripts/lib/file-preview-layout.test.mjs",
    "test:file-reference-navigation": "node --test scripts/lib/file-reference-navigation.test.mjs",
    "test:desktop:integration": "pnpm test:desktop-bridge && pnpm test:composer-input && pnpm test:composer-continuation && pnpm test:startup-presentation && pnpm test:file-preview-layout && pnpm test:file-reference-navigation && pnpm test:camp-fast-layout && pnpm test:camp-open-projection && pnpm test:execution-avatar-rail && pnpm test:approval-dock",
    "test:core-startup": "cargo build -p rovai-core --bins && node --test scripts/lib/core-startup-availability.test.mjs",
    "test": "pnpm docs:test && pnpm docs:check && pnpm skills:test && pnpm skills:check && pnpm test:electron-sandbox-capability && vitest run && node --test scripts/lib/check-rust-staged.test.mjs scripts/lib/copilot-native-turn-reconciliation-evidence.test.mjs scripts/lib/dev-desktop.test.mjs scripts/lib/install-macos-daily.test.mjs scripts/lib/macos-app-verification.test.mjs scripts/lib/macos-signing-policy.test.mjs scripts/lib/macos-update-info.test.mjs scripts/lib/release-notes.test.mjs scripts/lib/missing-send-recovery-protocol.test.mjs scripts/lib/planned-shutdown-app-quit.test.mjs scripts/lib/sidecar-targets.test.mjs scripts/lib/windows-installer-shutdown.test.mjs scripts/lib/qualification-acceptance-v034.test.mjs scripts/lib/qualification-acceptance-v036.test.mjs scripts/lib/qualification-artifacts.test.mjs scripts/lib/qualification-bundle.test.mjs scripts/lib/qualification-case-v3.test.mjs scripts/lib/qualification-collaboration.test.mjs scripts/lib/qualification-collaboration-ledger.test.mjs scripts/lib/qualification-core.test.mjs scripts/lib/qualification-demo-cases.test.mjs scripts/lib/qualification-diagnostic-portfolio.test.mjs scripts/lib/qualification-evaluation.test.mjs scripts/lib/qualification-evidence-index.test.mjs scripts/lib/qualification-isolation.test.mjs scripts/lib/qualification-judge-views.test.mjs scripts/lib/qualification-observation.test.mjs scripts/lib/qualification-public-report.test.mjs scripts/lib/qualification-recovery.test.mjs scripts/lib/qualification-schema-validation.test.mjs scripts/lib/qualification-semantic-evidence.test.mjs scripts/lib/qualification-semantic-judge.test.mjs scripts/lib/qualification-tool-evidence.test.mjs scripts/lib/qualification-tool-ledger.test.mjs scripts/lib/qualification-tool-use-judge.test.mjs scripts/lib/qualification-workspace-mutation-ledger.test.mjs scripts/lib/tool-interaction-measurement/index.test.mjs scripts/lib/qualification-tool-measurement-spec.test.mjs scripts/benchmark-paired-collaboration.test.mjs scripts/benchmark/*.test.mjs scripts/benchmark/**/*.test.mjs",
    "smoke:core": "pnpm core:build:debug && node scripts/smoke-core.mjs",
    "smoke:member-config": "pnpm core:build:debug && node scripts/smoke-member-config.mjs",
    "smoke:intake": "pnpm core:build:debug && node scripts/smoke-intake.mjs",
    "smoke:acp-runtime": "pnpm core:build:debug && node scripts/smoke-acp-runtime.mjs",
    "smoke:trae-cold-resume": "pnpm core:build:debug && node scripts/smoke-trae-cold-resume.mjs",
    "smoke:pi-runtime": "pnpm core:build:debug && node scripts/smoke-pi-runtime.mjs",
    "smoke:grok-cold-resume": "pnpm core:build:debug && ROVAI_COLD_RESUME_ADAPTER=grok-build node scripts/smoke-trae-cold-resume.mjs",
    "smoke:claude-runtime": "pnpm core:build:debug && node scripts/smoke-claude-runtime.mjs",
    "smoke:grok-runtime": "node scripts/probe-grok-runtime.mjs",
    "smoke:antigravity-runtime": "pnpm core:build:debug && node scripts/smoke-antigravity-runtime.mjs",
    "smoke:builtin-cli": "pnpm core:build:debug && node scripts/smoke-builtin-cli.mjs",
    "qualification:demo:check": "node scripts/qualification-demo-cases.mjs check",
    "qualification:case": "node scripts/qualification-case.mjs",
    "qualification:run": "node scripts/qualification-runner.mjs",
    "qualification:evaluate": "node scripts/qualification-evaluate.mjs",
    "qualification:judge": "node scripts/qualification-semantic-review.mjs",
    "qualification:tool-measurement-pack": "node scripts/qualification-tool-measurement-pack.mjs",
    "qualification:tool-use-judge": "node scripts/qualification-tool-use-review.mjs",
    "qualification:bundle:verify": "node scripts/qualification-verify-bundle.mjs",
    "qualification:portfolio": "node scripts/qualification-diagnostic-portfolio.mjs",
    "qualification:acceptance:v0.34": "node scripts/qualification-acceptance-v034.mjs",
    "qualification:acceptance:v0.36": "node scripts/qualification-acceptance-v036.mjs",
    "qualification:suite": "node scripts/qualification-suite.mjs",
    "qualification:project": "node scripts/project-qualification-benchmark.mjs",
    "benchmark:validate": "node scripts/benchmark-validate.mjs",
    "benchmark:run:contract": "node scripts/benchmark-current-contract.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "benchmark:paired": "node scripts/benchmark-paired-collaboration.mjs",
    "benchmark:project": "node scripts/benchmark-project.mjs",
    "benchmark:check": "node --test scripts/benchmark/*.test.mjs scripts/benchmark/**/*.test.mjs",
    "smoke:action-approval": "pnpm core:build:debug && node scripts/smoke-action-approval.mjs",
    "smoke:runtime-permissions": "pnpm smoke:action-approval && pnpm smoke:multi-agent",
    "accept:v0.16": "cargo test -p rovai-core db::tests::v27_freezes_active_runs_on_legacy_semantics_and_keeps_terminal_history && cargo test -p rovai-core team_tool::tests::call_member_persists_one_input_before_materializing_one_run && cargo test -p rovai-core action::tests::restart_fails_closed_intercepted_approvals_and_authorization_deliveries && pnpm test && pnpm smoke:runtime-permissions && pnpm smoke:acp-runtime",
    "accept:v0.17": "cargo test -p rovai-core db::tests::v28_adds_execution_evidence_and_structured_camp_presentations && cargo test -p rovai-core execution_evidence::tests::provider_packets_are_reduced_to_public_evidence_fields && cargo test -p rovai-core execution_evidence::tests::evidence_is_durable_blob_backed_agent_inaccessible_and_cancel_fenced && cargo test -p rovai-core runtime::tests::camp_turn_cancellation_is_persisted_and_finalized_from_authoritative_state && cargo test -p rovai-core team_tool::tests::recipient_completion_without_another_call_never_contacts_the_source && cargo test -p rovai-core --bin rovai-core tests::acp_tool_events_expose_digests_not_raw_payloads && pnpm typecheck && pnpm test",
    "smoke:multi-agent": "pnpm core:build:debug && node scripts/smoke-multi-agent.mjs",
    "smoke:attachments": "pnpm core:build:debug && node scripts/smoke-camp-attachments.mjs",
    "smoke:skills": "pnpm core:build:debug && node scripts/smoke-skills.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:mcp-projection": "pnpm core:build:debug && node scripts/smoke-mcp-projection.mjs",
    "smoke:memory": "pnpm core:build:debug && node scripts/smoke-memory.mjs",
    "smoke:memory-runtime": "pnpm core:build:debug && node scripts/smoke-memory-runtime.mjs",
    "diagnose:memory-camp": "pnpm core:build:debug && node scripts/diagnose-memory-camp-matrix.mjs",
    "accept:memory-ui": "node scripts/accept-memory-ui.mjs",
    "accept:member-avatar-ui": "node scripts/accept-member-avatar-ui.mjs",
    "accept:member-lifecycle-ui": "node scripts/accept-member-lifecycle-ui.mjs",
    "accept:notification-ui": "node scripts/accept-notification-ui.mjs",
    "accept:sidebar-ui": "node scripts/accept-sidebar-ui.mjs",
    "accept:conversation-find-ui": "node scripts/accept-conversation-find-ui.mjs",
    "accept:composer-skill-picker-ui": "node scripts/accept-structured-mentions-ui.mjs --skill-picker-only",
    "accept:composer-skill-context": "node scripts/accept-structured-mentions-ui.mjs --skill-context-smoke",
    "accept:structured-mentions-ui": "node scripts/accept-structured-mentions-ui.mjs",
    "accept:task-card-ui": "node scripts/accept-task-card-ui.mjs",
    "accept:runtime-activity-ui": "node scripts/accept-runtime-activity-ui.mjs",
    "accept:world-map-ui": "ROVAI_RUNTIME_ACTIVITY_ACCEPT_WORLD_MAP_ONLY=1 node scripts/accept-runtime-activity-ui.mjs",
    "accept:conversation-drop-zone-ui": "ROVAI_RUNTIME_ACTIVITY_ACCEPT_DROP_ZONE_ONLY=1 node scripts/accept-runtime-activity-ui.mjs",
    "accept:planned-shutdown": "node scripts/accept-planned-shutdown.mjs",
    "accept:windows:installer-shutdown": "node scripts/accept-windows-installer-shutdown.mjs",
    "accept:windows:installer": "node scripts/accept-windows-installation.mjs",
    "accept:diagnostics-ui": "node scripts/accept-diagnostics-ui.mjs",
    "accept:app-updates-ui": "node scripts/accept-app-updates-ui.mjs",
    "accept:runtime-monitoring-ui": "node scripts/accept-runtime-monitoring-ui.mjs",
    "accept:onboarding-ui": "node scripts/accept-onboarding-ui.mjs",
    "accept:bootstrap-shell-ui": "node scripts/accept-bootstrap-shell-ui.mjs",
    "smoke:recovery": "pnpm core:build:debug && node scripts/smoke-recovery.mjs",
    "smoke:missing-send-recovery": "pnpm core:build:debug && node scripts/smoke-missing-send-recovery.mjs",
    "experiment:p1:copilot-native-turn": "node scripts/experiment-copilot-native-turn-reconciliation.mjs",
    "test:p1:copilot-native-turn-evidence": "node --test scripts/lib/copilot-native-turn-reconciliation-evidence.test.mjs",
    "package:mac:unsigned": "pnpm build:macos:arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 -c.mac.identity=-",
    "package:mac": "pnpm build:macos:arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 -c.mac.identity=-",
    "package:mac:daily": "pnpm build:macos:arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --publish never -c.mac.identity=- && node scripts/verify-macos-app.mjs arm64",
    "install:mac:daily": "node scripts/install-macos-daily.mjs",
    "dist:mac": "pnpm build:macos:arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64 --publish never -c.mac.identity=-",
    "dist:mac:release:arm64": "pnpm build:macos:arm64 && electron-builder --mac dmg zip --arm64 --publish never -c.mac.identity=\"Rovai Release Signing\" -c.forceCodeSigning=true",
    "dist:mac:release:x64": "pnpm build:macos:x64 && electron-builder --mac dmg zip --x64 --publish never -c.mac.identity=\"Rovai Release Signing\" -c.forceCodeSigning=true",
    "package:windows:x64": "pnpm build:windows:x64 && node scripts/package-windows.mjs dir && node scripts/verify-windows-release.mjs --unpacked-only",
    "dist:windows:x64": "pnpm build:windows:x64 && node scripts/package-windows.mjs nsis && node scripts/verify-windows-release.mjs",
    "dist:windows:release:x64": "pnpm build:windows:x64 && node scripts/package-windows.mjs nsis && node scripts/verify-windows-release.mjs --require-signed",
    "verify:windows": "node scripts/verify-windows-release.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-tabs": "1.1.17",
    "electron-updater": "6.8.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "rcedit": "5.0.2",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "ai.rovai.desktop",
    "productName": "Rovai AI",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "murray17",
        "repo": "rovai-ai",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    },
    "mac": {
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/macos-${arch}/rovai-core",
          "to": "bin/rovai-core"
        },
        {
          "from": "resources/bin/macos-${arch}/rovai",
          "to": "bin/rovai"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/rovai-core",
        "Contents/Resources/bin/rovai"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Rovai AI",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "artifactName": "Rovai-AI-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "executableName": "Rovai-ai",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "extraResources": [
        {
          "from": "resources/bin/windows-x64/rovai-core.exe",
          "to": "bin/rovai-core.exe"
        },
        {
          "from": "resources/bin/windows-x64/rovai.exe",
          "to": "bin/rovai.exe"
        }
      ],
      "artifactName": "Rovai-AI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "warningsAsErrors": true
    },
    "dmg": {
      "title": "Rovai AI ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
