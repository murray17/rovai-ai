{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/contracts/gather-completion-input-v1.schema.json",
  "title": "Rovai Gather Completion Current Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "gatherId", "commandId", "requestMessageId", "items"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "gather_completed" } }
    },
    "gatherId": { "$ref": "#/$defs/id" },
    "commandId": { "$ref": "#/$defs/id" },
    "requestMessageId": { "$ref": "#/$defs/id" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "capturedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId", "sourceAgentRunId", "retryGeneration", "sequence",
        "contentDigest", "bodyExcerpt", "bodyOriginalBytes", "bodyTruncated"
      ],
      "properties": {
        "messageId": { "$ref": "#/$defs/id" },
        "sourceAgentRunId": { "$ref": "#/$defs/id" },
        "retryGeneration": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "bodyExcerpt": { "type": "string", "maxLength": 1024 },
        "bodyOriginalBytes": { "type": "integer", "minimum": 0 },
        "bodyTruncated": { "type": "boolean" }
      }
    },
    "fallbackSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "contentDigest", "originalBytes", "truncated"],
      "properties": {
        "body": { "type": "string", "maxLength": 2048 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "originalBytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "terminalResolutionSource", "terminalReasonCode", "manualRetryAllowed"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "terminalResolutionSource": { "type": ["string", "null"], "maxLength": 256 },
        "terminalReasonCode": { "type": ["string", "null"], "maxLength": 256 },
        "manualRetryAllowed": { "const": false }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipientAgentId", "dispatchDeliveryId", "targetAgentRunId", "status",
        "terminalSource", "capturedMessages", "fallbackSummary", "error"
      ],
      "properties": {
        "recipientAgentId": { "$ref": "#/$defs/id" },
        "dispatchDeliveryId": { "$ref": "#/$defs/id" },
        "targetAgentRunId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "enum": ["succeeded", "failed", "cancelled", "interrupted_before_dispatch"] },
        "terminalSource": { "enum": ["delivery", "agent_run"] },
        "capturedMessages": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/capturedMessage" }
        },
        "fallbackSummary": { "oneOf": [{ "$ref": "#/$defs/fallbackSummary" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      }
    }
  }
}
