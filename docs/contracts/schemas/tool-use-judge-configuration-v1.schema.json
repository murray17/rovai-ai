{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/contracts/tool-use-judge-configuration-v1.schema.json",
  "title": "Rovai Tool-Use Judge Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "schemaId", "schemaVersion", "producer", "binding", "sourceBoundaries", "payloadDigest", "payload"],
  "properties": {
    "artifactId": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.tool-use-judge-configuration" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/producer" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId"],
      "properties": { "policyId": { "const": "tool-use-judge-v1" } }
    },
    "sourceBoundaries": { "type": "array", "minItems": 1, "maxItems": 1 },
    "payloadDigest": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configurationId", "model", "promptTemplates", "rubricDigest", "checklist", "decodingParameters", "retrySchedule", "capabilities", "reconciliation"],
      "properties": {
        "configurationId": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/stableId" },
        "model": { "type": "object" },
        "promptTemplates": { "type": "object" },
        "rubricDigest": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/digest" },
        "checklist": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true },
        "decodingParameters": { "type": "object" },
        "retrySchedule": { "type": "object" },
        "capabilities": { "const": { "tools": "none", "network": "none", "workspace": "none" } },
        "reconciliation": { "type": "object" }
      }
    }
  }
}
