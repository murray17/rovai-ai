{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/contracts/paired-collaboration-experiment-v1.schema.json",
  "title": "Rovai Paired Collaboration Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "definition", "arms", "validity", "observedOutcomeStratum", "outcomeStratum", "qualityComparison", "resourceComparison", "classification", "integrity"],
  "properties": {
    "schemaId": { "const": "rovai.benchmark.paired-comparison" },
    "schemaVersion": { "const": "1.0.0" },
    "definition": { "$ref": "#/$defs/definitionReference" },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "solo"],
      "properties": {
        "team": { "$ref": "#/$defs/teamArmReference" },
        "solo": { "$ref": "#/$defs/soloArmReference" }
      }
    },
    "validity": { "$ref": "#/$defs/validity" },
    "observedOutcomeStratum": { "$ref": "#/$defs/stratum" },
    "outcomeStratum": { "$ref": "#/$defs/stratum" },
    "qualityComparison": { "$ref": "#/$defs/qualityComparison" },
    "resourceComparison": { "$ref": "#/$defs/resourceComparison" },
    "classification": { "enum": ["dominant", "quality_gain_with_cost", "efficiency_gain", "dominated", "tradeoff", "tie", "inconclusive"] },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "definitionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "payloadDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "planBindingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest", "pairSlotId", "armPlanId", "trialId", "dispatchOrdinal"],
      "properties": {
        "planDigest": { "$ref": "#/$defs/digest" },
        "pairSlotId": { "type": "string", "minLength": 1 },
        "armPlanId": { "type": "string", "minLength": 1 },
        "trialId": { "type": "string", "minLength": 1 },
        "dispatchOrdinal": { "type": "integer", "minimum": 0 }
      }
    },
    "armReferenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment", "runId", "planBinding", "hardOutcome", "resourceMeasurementDigest"],
      "properties": {
        "treatment": {
          "oneOf": [
            { "enum": ["team", "solo"] },
            { "type": "null" }
          ]
        },
        "runId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "planBinding": {
          "oneOf": [
            { "$ref": "#/$defs/planBindingReference" },
            { "type": "null" }
          ]
        },
        "hardOutcome": { "enum": ["pass", "fail", "indeterminate"] },
        "resourceMeasurementDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "teamArmReference": {
      "allOf": [
        { "$ref": "#/$defs/armReferenceBase" },
        {
          "properties": {
            "treatment": {
              "oneOf": [
                { "const": "team" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "soloArmReference": {
      "allOf": [
        { "$ref": "#/$defs/armReferenceBase" },
        {
          "properties": {
            "treatment": {
              "oneOf": [
                { "const": "solo" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCodes"],
      "properties": {
        "status": { "enum": ["valid", "invalid"] },
        "reasonCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRole", "schemaId", "schemaVersion", "payloadDigest", "disclosure"],
      "properties": {
        "artifactRole": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "disclosure": { "enum": ["private", "public"] }
      }
    },
    "qualityComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verdict", "treatmentBlind", "configurationDigest", "blindingCanaryDigest", "evidenceReferences"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "verdict": { "enum": ["team_superior", "team_noninferior", "equivalent", "solo_superior", "indeterminate"] },
        "treatmentBlind": { "type": "boolean" },
        "configurationDigest": { "$ref": "#/$defs/nullableDigest" },
        "blindingCanaryDigest": { "$ref": "#/$defs/nullableDigest" },
        "evidenceReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" },
          "uniqueItems": true
        }
      }
    },
    "publishedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unit", "direction", "team", "solo", "delta", "ratio", "ratioStatus", "evidenceReferences"],
      "properties": {
        "status": { "const": "published" },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["lower_is_better", "higher_is_better", "descriptive"] },
        "team": { "type": "number", "minimum": 0 },
        "solo": { "type": "number", "minimum": 0 },
        "delta": { "type": "number" },
        "ratio": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "ratioStatus": { "enum": ["available", "undefined_zero_denominator"] },
        "evidenceReferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "solo"],
          "properties": {
            "team": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidenceReference" },
              "uniqueItems": true
            },
            "solo": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidenceReference" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "resourceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCodes", "metrics", "suppressedMetrics"],
      "properties": {
        "status": { "enum": ["eligible", "ineligible"] },
        "reasonCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "metrics": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/publishedMetric" }
            },
            { "type": "null" }
          ]
        },
        "suppressedMetrics": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "eligible" } } },
          "then": {
            "properties": {
              "reasonCodes": { "maxItems": 0 },
              "metrics": { "type": "object", "minProperties": 1 }
            }
          },
          "else": {
            "properties": {
              "metrics": { "type": "null" }
            }
          }
        }
      ]
    },
    "stratum": { "enum": ["both_pass", "team_only_pass", "solo_only_pass", "both_fail", "indeterminate"] },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadDigest"],
      "properties": {
        "payloadDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
