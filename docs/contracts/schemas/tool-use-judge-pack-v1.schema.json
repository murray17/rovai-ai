{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/contracts/tool-use-judge-pack-v1.schema.json",
  "title": "Rovai Tool-Use Judge Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "schemaId", "schemaVersion", "producer", "binding", "sourceBoundaries", "payloadDigest", "payload"],
  "properties": {
    "artifactId": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.tool-use-judge-pack" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/producer" },
    "binding": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/binding" },
    "sourceBoundaries": { "type": "array", "minItems": 1 },
    "payloadDigest": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "measurementArtifact", "modelInputDigest", "modelInput", "evidenceMap"],
      "properties": {
        "policyId": { "const": "tool-use-judge-pack-treatment-blind-v1" },
        "measurementArtifact": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/artifactRef" },
        "modelInputDigest": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/digest" },
        "modelInput": { "type": "object" },
        "evidenceMap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["localEvidenceId", "evidenceReference"],
            "properties": {
              "localEvidenceId": { "type": "string", "pattern": "^EV-[0-9]{4}$" },
              "evidenceReference": { "$ref": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json#/$defs/evidenceRef" }
            }
          }
        }
      }
    }
  }
}
