{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.34/semantic-judge-configuration.schema.json",
  "title": "Rovai v0.34 Semantic Judge Configuration",
  "$defs": {
    "checklistItemId": {
      "enum": [
        "SER.requirements.understanding",
        "SER.design.solution_fit",
        "SER.implementation.quality",
        "SER.testing.strategy",
        "SER.scope.discipline",
        "SER.collaboration.delegation",
        "SER.collaboration.handoff_clarity",
        "SER.collaboration.feedback_absorption",
        "SER.collaboration.lead_integration",
        "SER.response.claim_accuracy",
        "SER.response.limitations"
      ]
    },
    "exactChecklist": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/checklistItemId" },
      "allOf": [
        { "contains": { "const": "SER.requirements.understanding" } },
        { "contains": { "const": "SER.design.solution_fit" } },
        { "contains": { "const": "SER.implementation.quality" } },
        { "contains": { "const": "SER.testing.strategy" } },
        { "contains": { "const": "SER.scope.discipline" } },
        { "contains": { "const": "SER.collaboration.delegation" } },
        { "contains": { "const": "SER.collaboration.handoff_clarity" } },
        { "contains": { "const": "SER.collaboration.feedback_absorption" } },
        { "contains": { "const": "SER.collaboration.lead_integration" } },
        { "contains": { "const": "SER.response.claim_accuracy" } },
        { "contains": { "const": "SER.response.limitations" } }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "schemaId",
    "schemaVersion",
    "producer",
    "binding",
    "sourceBoundaries",
    "payloadDigest",
    "payload"
  ],
  "properties": {
    "artifactId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.semantic-judge-configuration" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "artifact-envelope.schema.json#/$defs/producer" },
    "binding": { "$ref": "artifact-envelope.schema.json#/$defs/binding" },
    "sourceBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact-envelope.schema.json#/$defs/sourceBoundary" }
    },
    "payloadDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationId",
        "model",
        "promptTemplates",
        "rubricDigest",
        "checklist",
        "decodingParameters",
        "packSchema",
        "replicaOutputSchema",
        "reviewSchema",
        "redactionPolicyDigest",
        "retrySchedule",
        "evidenceReferenceValidation",
        "reconciliation",
        "capabilities"
      ],
      "properties": {
        "configurationId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "snapshotId", "snapshotDigest"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
            "snapshotId": { "type": "string", "minLength": 1, "maxLength": 240 },
            "snapshotDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" }
          }
        },
        "promptTemplates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replicaA", "replicaB", "counterbalanceRuleDigest"],
          "properties": {
            "replicaA": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
            "replicaB": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
            "counterbalanceRuleDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" }
          }
        },
        "rubricDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
        "checklist": { "$ref": "#/$defs/exactChecklist" },
        "decodingParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "topP", "maxOutputTokens", "seed"],
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "topP": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "maxOutputTokens": { "type": "integer", "minimum": 1 },
            "seed": { "type": ["integer", "null"] }
          }
        },
        "packSchema": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "replicaOutputSchema": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "reviewSchema": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "redactionPolicyDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
        "retrySchedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumTransportAttempts", "backoffMilliseconds", "retryValidOutput"],
          "properties": {
            "maximumTransportAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
            "backoffMilliseconds": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "integer", "minimum": 0 }
            },
            "retryValidOutput": { "const": false }
          }
        },
        "evidenceReferenceValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "rejectUnresolved", "rejectOutOfPack"],
          "properties": {
            "mode": { "const": "exact_pack_closure" },
            "rejectUnresolved": { "const": true },
            "rejectOutOfPack": { "const": true }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replicas", "verdictMismatch", "confidenceMismatch", "voting", "averaging", "aggregateScore"],
          "properties": {
            "replicas": { "const": 2 },
            "verdictMismatch": { "const": "disagreement" },
            "confidenceMismatch": { "const": "diagnostic_only" },
            "voting": { "const": "forbidden" },
            "averaging": { "const": "forbidden" },
            "aggregateScore": { "const": "forbidden" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "network", "workspace"],
          "properties": {
            "tools": { "const": "none" },
            "network": { "const": "none" },
            "workspace": { "const": "none" }
          }
        }
      }
    }
  }
}
