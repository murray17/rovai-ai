{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.34/verification-catalog.schema.json",
  "title": "Rovai v0.34 Verification Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "schemaId",
    "schemaVersion",
    "producer",
    "binding",
    "sourceBoundaries",
    "payloadDigest",
    "payload"
  ],
  "properties": {
    "artifactId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.verification-catalog" },
    "schemaVersion": { "const": "1.1.0" },
    "producer": { "$ref": "artifact-envelope.schema.json#/$defs/producer" },
    "binding": { "$ref": "artifact-envelope.schema.json#/$defs/binding" },
    "sourceBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact-envelope.schema.json#/$defs/sourceBoundary" }
    },
    "payloadDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "caseId", "caseSeal", "checks"],
      "properties": {
        "catalogId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
        "caseId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
        "caseSeal": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkId",
              "kind",
              "observationAuthority",
              "runnerCheck",
              "categoryId",
              "requirementIds",
              "disclosure",
              "prerequisiteCheckIds"
            ],
            "properties": {
              "checkId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "kind": { "enum": ["hard", "diagnostic"] },
              "observationAuthority": { "enum": ["verifier", "runner"] },
              "runnerCheck": {
                "type": ["string", "null"],
                "enum": [null, "change_boundary"]
              },
              "categoryId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "requirementIds": {
                "type": "array",
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" }
              },
              "disclosure": { "enum": ["public", "withheld"] },
              "prerequisiteCheckIds": {
                "type": "array",
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "observationAuthority": { "const": "verifier" } },
                  "required": ["observationAuthority"]
                },
                "then": { "properties": { "runnerCheck": { "type": "null" } } },
                "else": { "properties": { "runnerCheck": { "const": "change_boundary" } } }
              }
            ]
          }
        }
      }
    }
  }
}
