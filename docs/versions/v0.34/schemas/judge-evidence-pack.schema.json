{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.34/judge-evidence-pack.schema.json",
  "title": "Rovai v0.34 Judge Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "schemaId",
    "schemaVersion",
    "producer",
    "binding",
    "sourceBoundaries",
    "payloadDigest",
    "payload"
  ],
  "properties": {
    "artifactId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.judge-evidence-pack" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "artifact-envelope.schema.json#/$defs/producer" },
    "binding": { "$ref": "artifact-envelope.schema.json#/$defs/binding" },
    "sourceBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact-envelope.schema.json#/$defs/sourceBoundary" }
    },
    "payloadDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "configurationArtifact",
        "case",
        "members",
        "workspaceChanges",
        "verificationFacts",
        "collaborationFacts",
        "toolFacts",
        "mutationFacts",
        "finalResponse",
        "untrustedEvidence",
        "checklistCoverage"
      ],
      "properties": {
        "packId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
        "configurationArtifact": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caseId", "title", "requirements"],
          "properties": {
            "caseId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requirementId", "criticality", "statement"],
                "properties": {
                  "requirementId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  "criticality": { "enum": ["critical", "non_critical"] },
                  "statement": { "type": "string", "minLength": 1, "maxLength": 2000 }
                }
              }
            }
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pseudonym", "declaredRole"],
            "properties": {
              "pseudonym": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "declaredRole": { "type": ["string", "null"], "maxLength": 160 }
            }
          }
        },
        "workspaceChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["changeId", "path", "operation", "boundedContextSegmentId", "evidenceReferences"],
            "properties": {
              "changeId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "operation": { "enum": ["create", "modify", "delete", "rename", "metadata"] },
              "boundedContextSegmentId": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "evidenceReferences": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
              }
            }
          }
        },
        "verificationFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkId", "kind", "categoryId", "requirementIds", "status", "evidenceReferences"],
            "properties": {
              "checkId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "kind": { "enum": ["hard", "diagnostic"] },
              "categoryId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "requirementIds": {
                "type": "array",
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" }
              },
              "status": { "enum": ["passed", "failed", "blocked", "indeterminate", "not_applicable"] },
              "evidenceReferences": {
                "type": "array",
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
              }
            }
          }
        },
        "collaborationFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factId",
              "factType",
              "callId",
              "senderPseudonym",
              "recipientPseudonym",
              "visibility",
              "contentSegmentId",
              "evidenceReferences"
            ],
            "properties": {
              "factId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "factType": {
                "enum": [
                  "accepted_call",
                  "recipient_input",
                  "recipient_run",
                  "public_camp_message",
                  "later_independent_call",
                  "task_fact",
                  "route_fact"
                ]
              },
              "callId": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "senderPseudonym": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "recipientPseudonym": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "visibility": {
                "enum": ["private_to_recipient", "visible_to_member", "public_to_camp", "evaluator_only"]
              },
              "contentSegmentId": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "evidenceReferences": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
              }
            }
          }
        },
        "toolFacts": {
          "type": "array",
          "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
        },
        "mutationFacts": {
          "type": "array",
          "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
        },
        "finalResponse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segmentId", "evidenceReference"],
          "properties": {
            "segmentId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
            "evidenceReference": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
          }
        },
        "untrustedEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segmentId", "kind", "authorPseudonym", "visibility", "content", "evidenceReference"],
            "properties": {
              "segmentId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
              "kind": { "enum": ["participant_message", "code", "comment", "final_response", "test_output"] },
              "authorPseudonym": {
                "anyOf": [
                  { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
                  { "type": "null" }
                ]
              },
              "visibility": {
                "enum": ["private_to_recipient", "visible_to_member", "public_to_camp", "workspace"]
              },
              "content": { "type": "string", "maxLength": 50000 },
              "evidenceReference": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
            }
          }
        },
        "checklistCoverage": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checklistItem", "coverage", "evidenceReferences"],
            "properties": {
              "checklistItem": {
                "$ref": "semantic-judge-configuration.schema.json#/$defs/checklistItemId"
              },
              "coverage": { "$ref": "artifact-envelope.schema.json#/$defs/coverage" },
              "evidenceReferences": {
                "type": "array",
                "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
              }
            }
          },
          "allOf": [
            { "contains": { "properties": { "checklistItem": { "const": "SER.requirements.understanding" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.design.solution_fit" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.implementation.quality" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.testing.strategy" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.scope.discipline" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.delegation" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.handoff_clarity" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.feedback_absorption" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.lead_integration" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.response.claim_accuracy" } }, "required": ["checklistItem"] } },
            { "contains": { "properties": { "checklistItem": { "const": "SER.response.limitations" } }, "required": ["checklistItem"] } }
          ]
        }
      }
    }
  }
}
