{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.34/artifact-envelope.schema.json",
  "title": "Rovai v0.34 Qualification Artifact Shared Types",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "typedReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/stableId" },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["complete", "partial", "unavailable", "not_applicable"]
        },
        "reason": {
          "anyOf": [
            { "$ref": "#/$defs/typedReason" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "complete" } },
            "required": ["state"]
          },
          "then": {
            "properties": { "reason": { "type": "null" } }
          },
          "else": {
            "properties": { "reason": { "$ref": "#/$defs/typedReason" } }
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "suiteId": { "$ref": "#/$defs/stableId" },
        "plannedSlotId": { "$ref": "#/$defs/stableId" },
        "trialId": { "$ref": "#/$defs/stableId" },
        "caseId": { "$ref": "#/$defs/stableId" },
        "caseSeal": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityClass", "sourceId", "digest", "coverage"],
      "properties": {
        "authorityClass": {
          "enum": ["core", "runner", "verifier", "runtime", "derived", "judge"]
        },
        "sourceId": { "$ref": "#/$defs/stableId" },
        "digest": { "$ref": "#/$defs/digest" },
        "throughSequence": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "declaredTotal": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "clockDomain": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "schemaId", "schemaVersion", "payloadDigest"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/stableId" },
        "schemaId": { "$ref": "#/$defs/stableId" },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "evidenceId"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/stableId" },
        "evidenceId": { "$ref": "#/$defs/stableId" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artifactHeaderProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "schemaId",
        "schemaVersion",
        "producer",
        "binding",
        "sourceBoundaries",
        "payloadDigest"
      ],
      "properties": {
        "artifactId": { "$ref": "#/$defs/stableId" },
        "schemaId": { "$ref": "#/$defs/stableId" },
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "producer": { "$ref": "#/$defs/producer" },
        "binding": { "$ref": "#/$defs/binding" },
        "sourceBoundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceBoundary" }
        },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
