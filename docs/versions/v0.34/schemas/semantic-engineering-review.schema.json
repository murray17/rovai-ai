{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.34/semantic-engineering-review.schema.json",
  "title": "Rovai v0.34 Semantic Engineering Review",
  "$defs": {
    "replicaObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "confidence", "evidenceReferences", "reason"],
      "properties": {
        "verdict": { "$ref": "judge-replica-result.schema.json#/$defs/verdict" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "evidenceReferences": {
          "type": "array",
          "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "reconciledItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklistItem",
        "state",
        "verdict",
        "replicaA",
        "replicaB",
        "evidenceReferences",
        "reason"
      ],
      "properties": {
        "checklistItem": {
          "$ref": "semantic-judge-configuration.schema.json#/$defs/checklistItemId"
        },
        "state": { "enum": ["agreed", "disagreed"] },
        "verdict": {
          "anyOf": [
            { "$ref": "judge-replica-result.schema.json#/$defs/verdict" },
            { "type": "null" }
          ]
        },
        "replicaA": { "$ref": "#/$defs/replicaObservation" },
        "replicaB": { "$ref": "#/$defs/replicaObservation" },
        "evidenceReferences": {
          "type": "array",
          "items": { "$ref": "artifact-envelope.schema.json#/$defs/evidenceRef" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1200 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "agreed" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "verdict": { "$ref": "judge-replica-result.schema.json#/$defs/verdict" }
            }
          },
          "else": {
            "properties": { "verdict": { "type": "null" } }
          }
        }
      ]
    },
    "exactReconciledItems": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/reconciledItem" },
      "allOf": [
        { "contains": { "properties": { "checklistItem": { "const": "SER.requirements.understanding" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.design.solution_fit" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.implementation.quality" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.testing.strategy" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.scope.discipline" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.delegation" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.handoff_clarity" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.feedback_absorption" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.collaboration.lead_integration" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.response.claim_accuracy" } }, "required": ["checklistItem"] } },
        { "contains": { "properties": { "checklistItem": { "const": "SER.response.limitations" } }, "required": ["checklistItem"] } }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "schemaId",
    "schemaVersion",
    "producer",
    "binding",
    "sourceBoundaries",
    "payloadDigest",
    "payload"
  ],
  "properties": {
    "artifactId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
    "schemaId": { "const": "rovai.qualification.semantic-engineering-review" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "artifact-envelope.schema.json#/$defs/producer" },
    "binding": { "$ref": "artifact-envelope.schema.json#/$defs/binding" },
    "sourceBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact-envelope.schema.json#/$defs/sourceBoundary" }
    },
    "payloadDigest": { "$ref": "artifact-envelope.schema.json#/$defs/digest" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId",
        "configurationArtifact",
        "packArtifact",
        "replicaArtifacts",
        "state",
        "items",
        "unavailableReason"
      ],
      "properties": {
        "reviewId": { "$ref": "artifact-envelope.schema.json#/$defs/stableId" },
        "configurationArtifact": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "packArtifact": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" },
        "replicaArtifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "artifact-envelope.schema.json#/$defs/artifactRef" }
        },
        "state": { "enum": ["complete", "disagreement", "unavailable"] },
        "items": { "type": "array" },
        "unavailableReason": {
          "anyOf": [
            { "$ref": "artifact-envelope.schema.json#/$defs/typedReason" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "complete" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/exactReconciledItems" },
                  { "items": { "properties": { "state": { "const": "agreed" } } } }
                ]
              },
              "unavailableReason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "disagreement" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/exactReconciledItems" },
                  { "contains": { "properties": { "state": { "const": "disagreed" } }, "required": ["state"] } }
                ]
              },
              "unavailableReason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "unavailable" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "items": { "maxItems": 0 },
              "unavailableReason": { "$ref": "artifact-envelope.schema.json#/$defs/typedReason" }
            }
          }
        }
      ]
    }
  }
}
