{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rovai.invalid/v0.36/qualification-case-manifest-v3.schema.json",
  "title": "Rovai v0.36 Qualification Case Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "visibility",
    "title",
    "tags",
    "fixtureDirectory",
    "promptFile",
    "verifierFile",
    "referenceDirectory",
    "challengeManifestFile",
    "requirements",
    "verificationCatalog",
    "expectedInitialFailureCheckIds",
    "publicChecks",
    "allowedPaths",
    "forbiddenPaths",
    "temporalWritePolicy",
    "toolchain",
    "budget"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "common.schema.json#/$defs/caseId" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "visibility": { "const": "diagnostic" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "tags": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "fixtureDirectory": { "$ref": "common.schema.json#/$defs/relativeLocator" },
    "promptFile": { "$ref": "common.schema.json#/$defs/relativeLocator" },
    "verifierFile": { "$ref": "common.schema.json#/$defs/relativeLocator" },
    "referenceDirectory": { "$ref": "common.schema.json#/$defs/relativeLocator" },
    "challengeManifestFile": { "$ref": "common.schema.json#/$defs/relativeLocator" },
    "requirements": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "verificationCatalog": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/catalogCheck" }
    },
    "expectedInitialFailureCheckIds": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/checkId" }
    },
    "publicChecks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/publicCheck" }
    },
    "allowedPaths": { "const": ["src/**", "tests/agent/**"] },
    "forbiddenPaths": {
      "const": ["tests/public/**", "fixtures/**", "package.json", "README.md"]
    },
    "temporalWritePolicy": { "enum": ["final_tree", "workspace_root_only"] },
    "toolchain": {
      "const": {
        "runtime": "node",
        "minimumMajorVersion": 26,
        "verificationProfileVersion": 1,
        "publicCheckTimeoutMs": 30000,
        "verifierTimeoutMs": 60000,
        "maxOutputBytes": 1048576
      }
    },
    "budget": {
      "const": {
        "elapsedSeconds": 900,
        "maxAgentRuns": 8,
        "maxAcceptedA2a": 7
      }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-DC[0-9]{3}-R[1-6]$"
    },
    "checkId": {
      "type": "string",
      "pattern": "^CHK-DC[0-9]{3}-[A-Z0-9._-]+$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "criticality", "categoryId", "statement"],
      "properties": {
        "requirementId": { "$ref": "#/$defs/requirementId" },
        "criticality": { "enum": ["critical", "non_critical"] },
        "categoryId": {
          "enum": [
            "workstream_a",
            "workstream_b",
            "workstream_c",
            "integration",
            "regression",
            "change_boundary"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "catalogCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "kind",
        "observationAuthority",
        "runnerCheck",
        "categoryId",
        "requirementIds",
        "disclosure",
        "prerequisiteCheckIds"
      ],
      "properties": {
        "checkId": { "$ref": "#/$defs/checkId" },
        "kind": { "enum": ["hard", "diagnostic"] },
        "observationAuthority": { "enum": ["verifier", "runner"] },
        "runnerCheck": { "enum": [null, "public_check", "change_boundary"] },
        "categoryId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "requirementIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        },
        "disclosure": { "enum": ["public", "withheld"] },
        "prerequisiteCheckIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/checkId" }
        }
      }
    },
    "publicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "initialExpectation", "command"],
      "properties": {
        "checkId": { "$ref": "#/$defs/checkId" },
        "initialExpectation": { "enum": ["fail", "pass"] },
        "command": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "prefixItems": [{ "const": "node" }, { "const": "--test" }],
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
